# Hugging Face API Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: Custom Hugging Face model (defaults to openai/whisper-large-v3)
HUGGINGFACE_MODEL=openai/whisper-large-v3

# Optional: Custom Hugging Face API URL (defaults to https://api-inference.huggingface.co)
HUGGINGFACE_API_URL=https://api-inference.huggingface.co